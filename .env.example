# ---------------------------------------------------------------------------
# Daily Flow Planner — environment variables
# Copy this file to `.env` and fill in the values from your Supabase project
# (Supabase dashboard → Project Settings → API / Database).
# `.env` is gitignored. In Vercel, set these same values in
# Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# --- Client (exposed to the browser; VITE_ vars are inlined at build time) ---
# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=
# Publishable (anon) key — the new "sb_publishable_..." key, or the legacy anon JWT
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Server (used during SSR / server functions; NOT exposed to the browser) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
# Service-role key — bypasses RLS. Server-only. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (used by drizzle-kit for migrations) ---
# Postgres connection string from Supabase → Project Settings → Database.
# Use the pooler/session connection string for one-off migration runs.
DATABASE_URL=

# --- Reminder cron endpoint auth (shared secret between pg_cron and the app) ---
# Any long random string. CRON_SECRET_PREVIOUS is optional, for rotation.
CRON_SECRET=
CRON_SECRET_PREVIOUS=
